#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin >> t;
 
    while (t--) {
        int n;
        cin >> n;
        vector<long long> a(n);
        for(int i=0;i<n;i++) {
            cin>>a[i];
        }
        long long ans=0;
        while(true){
            long long mx = a[0];
            long long mn = a[0];
            for (int i = 1; i < n; i++) {
                if(a[i]>mx) {
                    mx=a[i];
                }
 
                if(a[i]<mn) {
                    mn = a[i];
                }
            }
            if(mx==mn) {
                ans+=mx;
                break;
            }
            long long p = 1;
 
            while(p*2<=mx) {
                p*=2;
            }
            if (mn<p) {
                ans+=2*p-1;
                break;
            }
            ans+=p;
            for (int i=0;i<n;i++) {
                a[i]-=p;
            }
        }
 
        cout<<ans<<endl;
    }
    return 0;
}