#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        int eA=0;
        int oA=0;
        int eB=0;
        int oB=0;
        for(int i=0;i<n;++i){
            int x;
            cin>>x;
            if(x%2==0)eA++;
            else oA++;
        }
        for(int i=0;i<n;++i){
            int x;
            cin>>x;
            if(x%2==0)eB++;
            else oB++;
        }
        if(oA==oB && eA==eB)cout<<"YES"<<endl;
        else if(k%2==0 && oA>oB)cout<<"YES"<<endl;
        else if(k%2==1 && eA>eB)cout<<"YES"<<endl;
        else{
            cout<<"NO"<<endl;
        }
    }
}